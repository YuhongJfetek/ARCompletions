@model ARCompletions.Areas.Admin.Models.EmbeddingRebuildResultViewModel
@{
    ViewData["Title"] = "Embeddings 重建結果";
}

<h1>Embeddings 重建結果</h1>

<div class="mb-3">
    <div><strong>JobId:</strong> @Model.Job.JobId</div>
    <div><strong>Provider:</strong> @Model.Job.Provider</div>
    <div><strong>Model:</strong> @Model.Job.Model</div>
    <div><strong>Scope:</strong> @Model.Job.Scope</div>
    <div><strong>Status:</strong> @Model.Job.Status</div>
    <div><strong>Total:</strong> @Model.Job.TotalCount, Completed: @Model.Job.CompletedCount, Failed: @Model.Job.FailedCount</div>
    <div><strong>TriggeredBy:</strong> @Model.Job.TriggeredBy</div>
    <div><strong>StartedAt:</strong> @Model.Job.StartedAt</div>
    <div><strong>FinishedAt:</strong> @Model.Job.FinishedAt</div>
    @if (!string.IsNullOrEmpty(Model.Job.ErrorMessage))
    {
        <div class="text-danger"><strong>Error:</strong> @Model.Job.ErrorMessage</div>
    }
</div>

<div class="alert alert-info">
    本頁僅顯示本次重建的統計結果（不再重新查詢資料庫）。
    若需要檢視實際 Embedding 明細，可回到列表頁依 Provider/Model 搜尋。
</div>

<div class="mt-3">
    <a asp-area="Admin" asp-controller="BotEmbeddings" asp-action="Index" class="btn btn-sm btn-secondary">返回 Embeddings 列表</a>
</div>
