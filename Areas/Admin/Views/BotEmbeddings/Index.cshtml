@model IEnumerable<ARCompletions.Domain.BotFaqEmbedding>
@{
    ViewData["Title"] = "重建Bot Embeddings";
}

<h1>重建Bot Embeddings</h1>

@{
    int ps = ViewBag.PageSize ?? 25;
}

@* 搜尋表單已移除 (搜尋/輸入欄位已改由其他管理工具或篩選面板處理) *@

<div class="mb-2">
    <form asp-area="Admin" asp-controller="BotEmbeddings" asp-action="RebuildAll" method="post" class="d-inline ms-2">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-sm btn-warning" onclick="return confirm('確定要觸發 Embeddings 全量重建嗎？可能需要一些時間完成。');">重建 Embeddings</button>
    </form>
</div>

<div id="rebuild-result">
    <h2>Embeddings 重建結果</h2>

    <div id="detail-loading" class="alert alert-info" style="display:none">
        <div class="spinner-border spinner-border-sm me-2" role="status"></div>
        <span id="detail-loading-text">正在彙整重建結果與明細，請稍候…</span>
    </div>

    <div id="rebuild-content" style="display:none">
        <div class="mb-3">
            <div><strong>JobId:</strong> <span id="r-jobid"></span></div>
            <div><strong>Provider:</strong> <span id="r-provider"></span></div>
            <div><strong>Model:</strong> <span id="r-model"></span></div>
            <div><strong>Scope:</strong> <span id="r-scope"></span></div>
            <div><strong>Status:</strong> <span id="r-status"></span></div>
            <div><strong>Total:</strong> <span id="r-total"></span>, Completed: <span id="r-completed"></span>, Failed: <span id="r-failed"></span></div>
            <div><strong>TriggeredBy:</strong> <span id="r-triggeredby"></span></div>
            <div><strong>StartedAt:</strong> <span id="r-started"></span></div>
            <div><strong>FinishedAt:</strong> <span id="r-finished"></span></div>
            <div id="r-error" class="text-danger" style="display:none"></div>
        </div>

        <div class="alert alert-info">
            本區會在重建完成並整理好明細後一次顯示結果。
        </div>

        <div class="mt-3">
            <!-- 返回按鈕已移除；頁面會自動顯示重建結果 -->
        </div>

        <hr />

        <h3>重建 Embeddings 明細</h3>
        <div id="rebuild-status">狀態：<span id="job-status">等待中</span></div>

        <table class="table table-striped table-sm" id="emb-table">
        <thead>
            <tr>
                <th>EmbeddingId</th>
                <th>FaqId</th>
                <th>Provider</th>
                <th>Model</th>
                <th>IsActive</th>
                <th>Actions</th>
                <th>CreatedAt</th>
                <th>RebuiltAt</th>
            </tr>
        </thead>
        <tbody>
            <!-- 由 JS 填充 -->
        </tbody>
    </table>
</div>

<script>
    // helper to POST a single-FAQ rebuild (moved out of the removed search form)
    async function rebuildFaq(faqId) {
        if (!faqId) return alert('無效的 FaqId');
        if (!confirm('確定要對 FaqId ' + faqId + ' 觸發重建？')) return;

        // grab antiforgery token from the existing RebuildAll form
        const form = document.querySelector('form[asp-action="RebuildAll"]') || document.querySelector('form');
        let token = null;
        if (form) {
            const t = form.querySelector('input[name="__RequestVerificationToken"]');
            if (t) token = t.value;
        }

        const body = new URLSearchParams();
        body.append('faqId', faqId);
        if (token) body.append('__RequestVerificationToken', token);

        try {
            const res = await fetch('/Admin/BotEmbeddings/RebuildFaq', {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: body
            });
            if (!res.ok) {
                const err = await res.json().catch(()=>({ error: '未知錯誤' }));
                return alert('重建請求失敗: ' + (err.error || ''));
            }
            const data = await res.json();
            alert('已觸發重建，JobId: ' + (data.JobId || data.jobId || ''));
        } catch (e) {
            console.error(e);
            alert('重建請求失敗（網路或伺服器錯誤）');
        }
    }
    (function(){
        const params = new URLSearchParams(window.location.search);
        const jobId = params.get('jobId');
        // Remove jobId from URL to avoid accidental re-entry showing loading state
        try {
            if (jobId && window.history && history.replaceState) {
                const u = new URL(window.location.href);
                u.searchParams.delete('jobId');
                history.replaceState(null, '', u.pathname + u.search + u.hash);
            }
        } catch (e) {
            // ignore
        }
        var rebuildTriggered = '@(TempData["RebuildTriggered"] != null ? "1" : "0")';
        if (!jobId || rebuildTriggered !== '1') return; // only poll when rebuild button actually triggered

        const tbody = document.querySelector('#emb-table tbody');
        const clearRows = () => { tbody.innerHTML = ''; };
        const detailLoading = document.getElementById('detail-loading');
        const detailLoadingText = document.getElementById('detail-loading-text');

        function showLoading(msg) {
            detailLoading.style.display = 'block';
            detailLoadingText.textContent = msg;
        }
        function hideLoading() { detailLoading.style.display = 'none'; }

        function fillJob(job) {
            document.getElementById('r-jobid').textContent = job.jobId || job.JobId || '';
            document.getElementById('r-provider').textContent = job.provider || job.Provider || '';
            document.getElementById('r-model').textContent = job.model || job.Model || '';
            document.getElementById('r-scope').textContent = job.scope || job.Scope || '';
            document.getElementById('r-status').textContent = job.status || job.Status || '';
            document.getElementById('r-total').textContent = job.totalCount || job.TotalCount || '';
            document.getElementById('r-completed').textContent = job.completedCount || job.CompletedCount || '';
            document.getElementById('r-failed').textContent = job.failedCount || job.FailedCount || '';
            document.getElementById('r-triggeredby').textContent = job.triggeredBy || job.TriggeredBy || '';
            document.getElementById('r-started').textContent = job.startedAt || job.StartedAt || '';
            document.getElementById('r-finished').textContent = job.finishedAt || job.FinishedAt || '';
            const err = job.errorMessage || job.ErrorMessage || '';
            if (err) { document.getElementById('r-error').style.display = 'block'; document.getElementById('r-error').textContent = err; }
        }

        // Poll with timeout/backoff
        const maxAttempts = 60; // up to ~3 minutes (with 3s interval)
        let attempts = 0;

        async function poll() {
            attempts++;
            try {
                const res = await fetch('/Admin/BotEmbeddings/RebuildStatus?jobId=' + encodeURIComponent(jobId));
                if (!res.ok) {
                    if (attempts < maxAttempts) setTimeout(poll, 3000);
                    return;
                }
                const data = await res.json();
                const job = data.job || data.Job || {};
                const emb = data.embeddings || data.Embeddings || [];

                const status = (job.status || job.Status || '').toLowerCase();
                const ready = data.ready || data.Ready || false;

                // If backend indicates readiness -> render both job and details at once
                if (ready) {
                    fillJob(job);
                    if (emb && emb.length > 0) {
                        clearRows();
                        for (const e of emb) {
                            const tr = document.createElement('tr');
                            tr.innerHTML = `
                                    <td>${e.embeddingId || e.EmbeddingId}</td>
                                    <td>${e.faqId || e.FaqId}</td>
                                    <td>${e.embeddingProvider || e.EmbeddingProvider}</td>
                                    <td>${e.embeddingModel || e.EmbeddingModel}</td>
                                    <td>${(e.isActive || e.IsActive) ? '是' : '否'}</td>
                                    <td>
                                        <div class="btn-group">
                                            <a class="btn btn-sm btn-outline-primary" href="/Admin/BotEmbeddings/Details/${e.embeddingId || e.EmbeddingId}">檢視</a>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="rebuildFaq('${e.faqId || e.FaqId}')">重建此 FAQ</button>
                                        </div>
                                    </td>
                                    <td>${e.createdAt || e.CreatedAt}</td>
                                    <td>${e.rebuiltAt || e.RebuiltAt}</td>
                            `;
                            tbody.appendChild(tr);
                        }
                    }
                    document.getElementById('rebuild-content').style.display = 'block';
                    hideLoading();
                    document.getElementById('job-status').textContent = status || 'ready';
                    return;
                }

                // Not ready yet: show progress if running, otherwise keep waiting
                if (status === 'running') {
                    showLoading(`重建中，已完成 ${job.completedCount || job.CompletedCount || 0} / ${job.totalCount || job.TotalCount || '?'}，請稍候…`);
                    if (attempts < maxAttempts) setTimeout(poll, 3000);
                    return;
                }

                // For any other non-ready terminal state, continue polling until backend flips Ready or timeout
                if (attempts < maxAttempts) setTimeout(poll, 3000);
                else {
                    // timeout: show what we have
                    fillJob(job);
                    if (emb && emb.length > 0) {
                        clearRows();
                        for (const e of emb) {
                            const tr = document.createElement('tr');
                            tr.innerHTML = `
                                    <td>${e.embeddingId || e.EmbeddingId}</td>
                                    <td>${e.faqId || e.FaqId}</td>
                                    <td>${e.embeddingProvider || e.EmbeddingProvider}</td>
                                    <td>${e.embeddingModel || e.EmbeddingModel}</td>
                                    <td>${(e.isActive || e.IsActive) ? '是' : '否'}</td>
                                    <td>
                                        <div class="btn-group">
                                            <a class="btn btn-sm btn-outline-primary" href="/Admin/BotEmbeddings/Details/${e.embeddingId || e.EmbeddingId}">檢視</a>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="rebuildFaq('${e.faqId || e.FaqId}')">重建此 FAQ</button>
                                        </div>
                                    </td>
                                    <td>${e.createdAt || e.CreatedAt}</td>
                                    <td>${e.rebuiltAt || e.RebuiltAt}</td>
                            `;
                            tbody.appendChild(tr);
                        }
                    }
                    document.getElementById('rebuild-content').style.display = 'block';
                    hideLoading();
                    document.getElementById('job-status').textContent = 'timed out';
                    return;
                }

            } catch (err) {
                console.error(err);
            }

            if (attempts < maxAttempts) setTimeout(poll, 3000);
        }

        // Initialize: fetch once to decide whether to show loading/polling.
        (async function init() {
            try {
                const res = await fetch('/Admin/BotEmbeddings/RebuildStatus?jobId=' + encodeURIComponent(jobId));
                if (!res.ok) return; // no job or error
                const data = await res.json();
                const job = data.job || data.Job || {};
                const ready = data.ready || data.Ready || false;
                const status = (job.status || job.Status || '').toLowerCase();

                if (ready) {
                    // job already ready -> render results immediately
                    fillJob(job);
                    const emb = data.embeddings || data.Embeddings || [];
                    if (emb && emb.length > 0) {
                        clearRows();
                        for (const e of emb) {
                            const tr = document.createElement('tr');
                            tr.innerHTML = `
                                    <td>${e.embeddingId || e.EmbeddingId}</td>
                                    <td>${e.faqId || e.FaqId}</td>
                                    <td>${e.embeddingProvider || e.EmbeddingProvider}</td>
                                    <td>${e.embeddingModel || e.EmbeddingModel}</td>
                                    <td>${(e.isActive || e.IsActive) ? '是' : '否'}</td>
                                    <td>
                                        <div class="btn-group">
                                            <a class="btn btn-sm btn-outline-primary" href="/Admin/BotEmbeddings/Details/${e.embeddingId || e.EmbeddingId}">檢視</a>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="rebuildFaq('${e.faqId || e.FaqId}')">重建此 FAQ</button>
                                        </div>
                                    </td>
                                    <td>${e.createdAt || e.CreatedAt}</td>
                                    <td>${e.rebuiltAt || e.RebuiltAt}</td>
                            `;
                            tbody.appendChild(tr);
                        }
                    }
                    document.getElementById('rebuild-content').style.display = 'block';
                    hideLoading();
                    document.getElementById('job-status').textContent = status || 'ready';
                    return;
                }

                // only show loading and start polling if job is actively running
                if (status === 'running') {
                    showLoading(`重建中，已完成 ${job.completedCount || job.CompletedCount || 0} / ${job.totalCount || job.TotalCount || '?'}，請稍候…`);
                    clearRows();
                    poll();
                    return;
                }

                // otherwise do nothing (no visible loading) — likely jobId was present accidentally
                hideLoading();
            } catch (err) {
                console.error(err);
            }
        })();

    })();
</script>

@{
    long total = ViewBag.TotalCount ?? 0L;
    int page = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 25;
    var totalPages = (int)System.Math.Ceiling(total / (double)pageSize);
}

@{
    // Only render pagination when not showing rebuild results.
    var rebuildTriggered = TempData["RebuildTriggered"] != null;
    var hasJobIdQuery = !string.IsNullOrWhiteSpace(Context.Request.Query["jobId"].ToString());
}
@if (!rebuildTriggered && !hasJobIdQuery && totalPages > 1)
{
    <nav id="emb-pagination">
        <ul class="pagination pagination-sm">
            <li class="page-item @(page<=1?"disabled":"")">
                <a class="page-link" href="?page=@(page-1)&pageSize=@pageSize&faqId=@ViewBag.FaqId&isActive=@ViewBag.IsActive&provider=@ViewBag.Provider&model=@ViewBag.Model">上一頁</a>
            </li>
            @for (var p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p==page?"active":"")">
                    <a class="page-link" href="?page=@p&pageSize=@pageSize&faqId=@ViewBag.FaqId&isActive=@ViewBag.IsActive&provider=@ViewBag.Provider&model=@ViewBag.Model">@p</a>
                </li>
            }
            <li class="page-item @(page>=totalPages?"disabled":"")">
                <a class="page-link" href="?page=@(page+1)&pageSize=@pageSize&faqId=@ViewBag.FaqId&isActive=@ViewBag.IsActive&provider=@ViewBag.Provider&model=@ViewBag.Model">下一頁</a>
            </li>
        </ul>
    </nav>
}

<script>
    // Hide pagination when viewing rebuild result (jobId present)
    (function(){
        const params = new URLSearchParams(window.location.search);
        const jobId = params.get('jobId');
        var rebuildTriggered = '@(TempData["RebuildTriggered"] != null ? "1" : "0")';
        // hide pagination when a rebuild was actually triggered or when a jobId exists
        if (!jobId && rebuildTriggered !== '1') return;
        const nav = document.getElementById('emb-pagination');
        if (nav) nav.style.display = 'none';
    })();
</script>
