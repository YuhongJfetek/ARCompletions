@model IEnumerable<ARCompletions.Areas.Admin.Models.FaqSuggestionViewModel>
@{
    ViewData["Title"] = "FAQ 建議 (對話分析)";
    long total = ViewBag.TotalCount ?? 0L;
    int page = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 50;
    int days = ViewBag.Days ?? 7;
    string? route = ViewBag.Route as string;
    bool onlyWithoutFaq = ViewBag.OnlyWithoutFaq ?? true;
    var totalPages = (int)System.Math.Ceiling(total / (double)pageSize);
}

<h1>FAQ 建議 (對話分析)</h1>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <label class="form-label form-label-sm">最近天數</label>
        <input type="number" name="days" value="@days" min="1" max="90" class="form-control form-control-sm" />
    </div>
    <div class="col-auto">
        <label class="form-label form-label-sm">Route</label>
        <select name="route" class="form-select form-select-sm">
            <option value="">全部</option>
            <option value="faq_match" selected="@(route == "faq_match" ? "selected" : null)">faq_match</option>
            <option value="low_confidence" selected="@(route == "low_confidence" ? "selected" : null)">low_confidence</option>
            <option value="fallback" selected="@(route == "fallback" ? "selected" : null)">fallback</option>
        </select>
    </div>
    <div class="col-auto d-flex align-items-end">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="onlyWithoutFaq" value="true" id="chkOnlyWithoutFaq" @(onlyWithoutFaq ? "checked" : "") />
            <label class="form-check-label" for="chkOnlyWithoutFaq">僅顯示未對應 FAQ</label>
        </div>
    </div>
    <div class="col-auto d-flex align-items-end">
        <button type="submit" class="btn btn-sm btn-primary">重新分析</button>
        <a asp-area="Admin" asp-controller="BotFaqItems" asp-action="Index" class="btn btn-sm btn-outline-secondary ms-2">返回 FAQ 管理</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">目前查詢條件下沒有可用的 FAQ 建議。</div>
}
else
{
    <table class="table table-striped table-sm align-middle">
        <thead>
            <tr>
                <th>時間</th>
                <th>來源</th>
                <th>使用者訊息</th>
                <th>建議回答</th>
                <th>Route / 理由</th>
                <th>FAQ / 分數</th>
                <th>LLM 信心</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td style="white-space:nowrap;">@s.ReceivedAt.ToLocalTime()</td>
                <td>
                    @s.SourceType<br />
                    <small class="text-muted">@s.ConversationId<br />@s.LineUserId</small>
                </td>
                <td style="max-width:260px; white-space:pre-wrap;">
                    @if (!string.IsNullOrWhiteSpace(s.UserText))
                    {
                        @s.UserText
                    }
                    else
                    {
                        <span class="text-muted">(無法解析使用者訊息，請從對話紀錄檢視)</span>
                    }
                </td>
                <td style="max-width:260px; white-space:pre-wrap;">
                    @if (!string.IsNullOrWhiteSpace(s.SuggestedAnswer))
                    {
                        @s.SuggestedAnswer
                    }
                </td>
                <td>
                    @s.Route
                    @if (!string.IsNullOrEmpty(s.Reason))
                    {
                        <br /><small class="text-muted">@s.Reason</small>
                    }
                </td>
                <td>
                    @if (!string.IsNullOrEmpty(s.MatchedFaqId))
                    {
                        <div>FaqId: @s.MatchedFaqId</div>
                    }
                    @if (s.MatchedScore.HasValue)
                    {
                        <div>Score: @s.MatchedScore.Value.ToString("F3")</div>
                    }
                    @if (!string.IsNullOrEmpty(s.FaqCategory))
                    {
                        <div>Category: @s.FaqCategory</div>
                    }
                </td>
                <td>
                    @if (s.LlmConfidence.HasValue)
                    {
                        <div>@s.LlmConfidence.Value.ToString("F3")</div>
                    }
                    @if (!string.IsNullOrEmpty(s.LlmModel))
                    {
                        <div><small>@s.LlmModel</small></div>
                    }
                </td>
                <td>
                    @if (string.IsNullOrEmpty(s.MatchedFaqId))
                    {
                        <a asp-area="Admin" asp-controller="BotFaqItems" asp-action="Create"
                           asp-route-question="@s.UserText" asp-route-answer="@s.SuggestedAnswer" asp-route-categoryKey="@s.FaqCategory"
                           class="btn btn-sm btn-success mb-1">建立 FAQ</a>
                    }
                    else
                    {
                        <a asp-area="Admin" asp-controller="BotFaqItems" asp-action="Edit" asp-route-id="@s.MatchedFaqId"
                           class="btn btn-sm btn-outline-secondary mb-1">編輯原 FAQ</a>
                    }
                    <a asp-area="Admin" asp-controller="BotConversations" asp-action="History"
                       asp-route-sourceType="@s.SourceType" asp-route-conversationId="@s.ConversationId"
                       class="btn btn-sm btn-outline-primary">查看對話</a>
                </td>
            </tr>
        }
        </tbody>
    </table>

    @if (totalPages > 1)
    {
        <nav>
            <ul class="pagination pagination-sm">
                <li class="page-item @(page<=1?"disabled":"")">
                    <a class="page-link" href="?page=@(page-1)&amp;pageSize=@pageSize&amp;days=@days&amp;route=@route&amp;onlyWithoutFaq=@onlyWithoutFaq">上一頁</a>
                </li>
                @for (var p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p==page?"active":"")">
                        <a class="page-link" href="?page=@p&amp;pageSize=@pageSize&amp;days=@days&amp;route=@route&amp;onlyWithoutFaq=@onlyWithoutFaq">@p</a>
                    </li>
                }
                <li class="page-item @(page>=totalPages?"disabled":"")">
                    <a class="page-link" href="?page=@(page+1)&amp;pageSize=@pageSize&amp;days=@days&amp;route=@route&amp;onlyWithoutFaq=@onlyWithoutFaq">下一頁</a>
                </li>
            </ul>
        </nav>
    }
}
